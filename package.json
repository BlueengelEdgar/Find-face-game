{
  "name": "find-face-game",
  "version": "0.5.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "vite build && node scripts/build-portable.mjs",
    "preview": "vite preview --host 0.0.0.0",
    "test": "node tests/model.test.js",
    "test:browser": "node tests/v05-browser.js && node tests/v05-regression.js",
    "art:extract": "node scripts/extract-art.mjs",
    "test:offline": "node tests/v05-regression.js --offline-only",
    "test:capacity": "python scripts/measure-v05-capacity.py && node tests/v05-capacity-preview.js"
  },
  "dependencies": {
    "phaser": "3.90.0"
  },
  "devDependencies": {
    "vite": "6.4.1",
    "@playwright/test": "1.56.1"
  }
}
